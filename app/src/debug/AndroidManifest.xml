<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (merged into the main manifest): the adb test hooks. Release builds don't ship
  them, so an installed BentoBar has no exported entry point beyond what Android needs (the
  launcher, the accessibility service, the tiles). The shell holds DUMP, apps don't.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".util.DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.kuscher.bentobar.DEBUG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
