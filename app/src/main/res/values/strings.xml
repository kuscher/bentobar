    <!-- base -->
    <string name="app_name">BentoBar</string>
    <string name="a11y_label">BentoBar</string>
    <string name="a11y_summary">Draws your BentoBar items in the status bar</string>
    <string name="a11y_description">BentoBar draws the items you add (network speed, timer, calendar, tools…) on top of the status bar. Android only allows that through an accessibility service.\n\nWhat BentoBar does with it: it reads the layout of the status bar, and nothing else, to find free space; it copies the color of the status bar clock so your items match; and it runs system actions such as screenshot or lock when you pick them in its Tools menu.\n\nIt does not read other apps\' windows, does not watch your keyboard, mouse or touches, and has no internet access.</string>
