<?xml version="1.0" encoding="utf-8"?>
<!-- Heat. Every name here starts with heat_, item_heat_ or trigger_heat. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">
    <string name="item_heat_title">Heat</string>
    <string name="item_heat_desc">Shows when Android slows a hot device; heat level in its menu</string>
    <string name="trigger_heat">Show when the device is at least %1$s, and for a minute after it cools</string>
    <string name="trigger_heat_short">shows when %1$s</string>
    <string name="heat_rule_warm">warm</string>
    <string name="heat_rule_hot">hot</string>
    <string name="heat_rule_very_hot">very hot</string>
    <string name="heat_note" formatted="false">At 100% Android slows the device down noticeably to cool it; a little slowing can start sooner. Android doesn\'t share CPU temperature or fan speed with apps.</string>
    <!-- The note on a device that reports no heat level: the first sentence would be about nothing. -->
    <string name="heat_note_no_level">Android doesn\'t share CPU temperature or fan speed with apps.</string>
    <!-- In the bar, for Android's statuses from light to emergency. -->
    <string name="heat_bar_warm">Warm</string>
    <string name="heat_bar_hot">Hot</string>
    <string name="heat_bar_very_hot">Very hot</string>
    <string name="heat_bar_critical">Critical</string>
    <string name="heat_bar_too_hot">Too hot</string>
    <!-- In the bar with the battery's temperature shown: "41° · Hot" (%1$s the temperature, %2$s the word). -->
    <string name="heat_bar_temp_word">%1$s · %2$s</string>
    <string name="heat_level">Heat level</string>
    <string name="heat_battery_temp">Battery temperature</string>
    <string name="heat_temp_c">%1$s °C</string>
    <string name="heat_temp_f">%1$s °F</string>
    <string name="heat_cpu_load">CPU load</string>
    <string name="heat_show_state">State</string>
    <!-- Spoken: %1$s is the state in words ("Hot, slowing a little"), %2$d the battery's temperature in the user's unit. -->
    <string name="heat_desc">Heat: %1$s</string>
    <string name="heat_desc_temp">Heat: %1$s, battery %2$d degrees</string>
</resources>
