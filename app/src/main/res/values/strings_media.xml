<!-- Now playing. Every name here starts with media_, item_media_ or trigger_media. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">
    <string name="item_media_title">Now playing</string>
    <string name="item_media_desc">What\'s playing, with pause and skip; shows while something plays</string>
    <string name="trigger_media">Show while something is playing, and for %1$s after it pauses</string>
    <string name="trigger_media_short">shows while playing</string>
    <string name="media_nothing">Nothing playing</string>
    <string name="media_playing">Playing</string>
    <!-- The menu's subtitle for a paused player: "Spotify · Paused". -->
    <string name="media_player_paused">%1$s · Paused</string>
