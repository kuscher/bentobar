    <string name="media_open_player">Open %1$s</string>
    <!-- The next four are also what the item's settings card and Setup's "Notification access" step say: keep their names. -->
    <string name="media_access_lead">See what\'s playing</string>
    <string name="media_access_explain">Android shares the title, artist and artwork only with apps that have notification access. BentoBar tells Android to send it no notifications at all; it reads only what your media players say is playing, and keeps that on this device.</string>
    <string name="media_access_restricted">Switch grayed out? Tap it, tap OK, then turn on Allow restricted settings in App info.</string>
    <string name="media_access_allow">Allow notification access</string>
    <string name="media_show_title">Title</string>
    <string name="media_show_both">Title and artist</string>
    <string name="media_show_artist">Artist</string>
    <string name="media_show_needs_access">Shows once notification access is on</string>
    <string name="media_click">A click</string>
    <string name="media_click_menu">Opens the menu</string>
    <string name="media_click_toggle">Plays or pauses</string>
    <!-- What a screen reader says for the item in the bar. -->
    <string name="media_desc_playing_by">Playing: %1$s by %2$s</string>
    <string name="media_desc_playing">Playing: %1$s</string>
    <string name="media_desc_paused">Paused: %1$s</string>
