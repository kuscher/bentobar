    <string name="item_shortcut_title">Shortcut</string>
    <string name="item_shortcut_desc">One click: a screenshot, a bug report, lock, overview and more</string>
    <!-- Opens the Googlebook's Feedback app. -->
    <string name="shortcut_report_bug">Report a bug</string>
    <!-- The item's settings: which action a click does. -->
    <string name="shortcut_action">Action</string>
    <!-- Spoken and as the tooltip, for Report a bug on a device without the Feedback app (a layout copied from a Googlebook). %1$s: "Report a bug". -->
    <string name="shortcut_unavailable_desc">%1$s: the Feedback app isn\'t on this device</string>
</resources>
