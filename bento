#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# BentoBar dev helper: build, install and drive the app on a Googlebook over adb.
#
#   ./bento build [release]   assemble the debug (or release) APK
#   ./bento app               build, install, enable the service, open settings
#   ./bento install | enable | disable | launch | stop
#   ./bento debug CMD...      test hooks (see util/DebugReceiver.kt): dump, cfg, reset, open TYPE,
#                             ctx TYPE, chevron, barmenu, close, timer MIN, awake [MIN|off], look KEY VALUE
#   ./bento logs [N]          BentoBar's log lines
#   ./bento shot [FILE] [H]   the top H px of the screen (status bar + menus; default 60), cropped
#   ./bento menushot [FILE]   the open menu's area
#   ./bento appshot [FILE]    the settings window
#
# adb's server listens on a Unix socket (VSCodeBook's), never tcp:5037: the Linux terminal
# forwards every TCP port to Android, where any app could reach it.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"
PKG=io.github.kuscher.bentobar
SVC="$PKG/$PKG.bar.BarService"
APK=app/build/outputs/apk/debug/app-debug.apk
ENVF="$HOME/.config/vscodebook/android.env"
[ -f "$ENVF" ] && . "$ENVF"
export ADB_SERVER_SOCKET=${ADB_SERVER_SOCKET:-localfilesystem:$HOME/.local/state/vscodebook/adb.sock}
TMP=${XDG_RUNTIME_DIR:-/tmp}

serial() { cat "$HOME/.config/vscodebook/adb-serial" 2>/dev/null; }
connect() {
  local s; s="$(serial)"
  if [ -n "$s" ] && adb -s "$s" shell true >/dev/null 2>&1; then echo "$s"; return; fi
  vscodebook android connect >/dev/null 2>&1 || true
  serial
}
A() { adb -s "$(connect)" "$@"; }
dbg() { A shell "am broadcast --user current -a $PKG.DEBUG -p $PKG --es c '$*'" >/dev/null; sleep 0.4
  A shell "logcat -d -s BentoBar:I" | grep "debug $1" | tail -1 | sed 's/.*-> //'; }

winshot() { # BentoBar's own window as a PNG: winshot TITLE|app FILE (debug builds; written to the app's cache)
  local r; r=$(A shell "am broadcast --user current -a $PKG.DEBUG -p $PKG --es c 'winshot $1'" | sed -n 's/.*data="\([^"]*\)".*/\1/p')
  case $r in file:*) A exec-out "run-as $PKG cat cache/winshot.png" > "$2"; echo "$2 (${r##* })" ;; *) echo "winshot: $r" >&2; return 1 ;; esac; }

build() { if [ "${1:-}" = release ]; then ./gradlew :app:assembleRelease --console=plain -q; else ./gradlew :app:assembleDebug --console=plain -q; fi; }

install() {
  local s; s="$(connect)"
  adb -s "$s" shell settings put global verifier_verify_adb_installs 0
  adb -s "$s" install -r "${1:-$APK}" || { adb -s "$s" shell settings put global verifier_verify_adb_installs 1; exit 1; }
  adb -s "$s" shell settings put global verifier_verify_adb_installs 1
}

# Adds or removes only BentoBar's service; other enabled services (StudioSnap, TalkBack…) stay.
# Entries may use the short (pkg/.Class) or full (pkg/pkg.Class) form; both mean BentoBar.
SVC_SHORT="$PKG/.bar.BarService"
others() { # the enabled list without BentoBar, colon-separated
  A shell settings get --user current secure enabled_accessibility_services | tr -d '\r' | tr ':' '\n' |
    grep -v -x -F -e "$SVC" -e "$SVC_SHORT" -e null | grep -v '^$' | paste -sd: || true
}
enable() {
  local rest; rest=$(others)
  A shell settings put --user current secure enabled_accessibility_services "${rest:+$rest:}$SVC"
  A shell settings put --user current secure accessibility_enabled 1
  echo "service enabled"
}
disable() {
  local rest; rest=$(others)
  if [ -z "$rest" ]; then A shell settings delete --user current secure enabled_accessibility_services >/dev/null
  else A shell settings put --user current secure enabled_accessibility_services "$rest"; fi
  echo "service disabled"
}

shot() {
  local out=${1:-$TMP/bentobar-bar.png} h=${2:-60}
  A exec-out screencap -p > "$out.full"
  python3 - "$out.full" "$out" "$h" <<'PY'
import sys
from PIL import Image
im = Image.open(sys.argv[1]); w, _ = im.size
im.crop((0, 0, w, int(sys.argv[3]))).save(sys.argv[2])
PY
  rm -f "$out.full"; echo "$out"
}

menushot() { # the BentoBar menu window's frame, from dumpsys
  local out=${1:-$TMP/bentobar-menu.png}
  read -r x1 y1 x2 y2 < <(A shell dumpsys window windows | awk '/Window #/ { m = index($0, "BentoBar menu") > 0 } m && /frame=\[/ { print; exit }' |
    grep -o 'frame=\[[0-9-]*,[0-9-]*\]\[[0-9]*,[0-9]*\]' | tr -c '0-9\n-' ' ')
  [ -n "${x1:-}" ] || { echo "no menu open" >&2; exit 1; }
  A exec-out screencap -p > "$out.full"
  python3 -c "import sys; from PIL import Image; Image.open(sys.argv[1]).crop(tuple(map(int, sys.argv[3:7]))).save(sys.argv[2])" "$out.full" "$out" "$x1" "$y1" "$x2" "$y2"
  rm -f "$out.full"; echo "$out"
}

appshot() { # BentoBar's settings window (the app's largest window)
  local out=${1:-$TMP/bentobar-app.png}
  read -r x1 y1 x2 y2 < <(A shell dumpsys window windows | awk -v pkg="$PKG/" '/Window #/ { m = index($0, pkg) > 0 } m && /frame=\[/ { print }' |
    grep -o 'frame=\[[0-9-]*,[0-9-]*\]\[[0-9]*,[0-9]*\]' | tr -c '0-9\n-' ' ' |
    awk '{ a = ($3 - $1) * ($4 - $2); if (a > best) { best = a; line = $1 " " $2 " " $3 " " $4 } } END { print line }')
  [ -n "${x1:-}" ] || { echo "settings not open" >&2; exit 1; }
  A exec-out screencap -p > "$out.full"
  python3 -c "import sys; from PIL import Image; Image.open(sys.argv[1]).crop(tuple(max(0, int(v)) for v in sys.argv[3:7])).save(sys.argv[2])" "$out.full" "$out" "$x1" "$y1" "$x2" "$y2"
  rm -f "$out.full"; echo "$out"
}

case "${1:-}" in
  build) shift; build "$@" ;;
  install) shift; install "$@" ;;
  app) build; install; enable; A shell am start --user current -n $PKG/.ui.MainActivity >/dev/null ;;
  enable) enable ;;
  disable) disable ;;
  launch) A shell am start --user current -n $PKG/.ui.MainActivity >/dev/null ;;
  stop) A shell am force-stop --user current $PKG ;;
  debug) shift; dbg "$@" ;;
  logs) A shell "logcat -d -s BentoBar:V AndroidRuntime:E" | tail -"${2:-40}" ;;
  shot) shift; shot "$@" ;;
  menushot) shift; menushot "$@" ;;
  appshot) shift; appshot "$@" ;;
  winshot) shift; winshot "$@" ;;
  *) sed -n '3,15p' "$0"; exit 1 ;;
esac
