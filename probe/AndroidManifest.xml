<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.barbook.probe" android:versionCode="1" android:versionName="0.0.1">
  <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="37"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <application android:label="BarBook probe" android:allowBackup="false" android:icon="@drawable/dot">
    <service android:name=".ProbeA11y" android:exported="true"
        android:label="BarBook probe (temporary test)"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/a11y"/>
    </service>
    <receiver android:name=".Cmd" android:exported="true" android:permission="android.permission.DUMP">
      <intent-filter><action android:name="local.barbook.probe.CMD"/></intent-filter>
    </receiver>
    <activity android:name=".FsActivity" android:exported="true" android:label="Fullscreen test"/>
  </application>
</manifest>
